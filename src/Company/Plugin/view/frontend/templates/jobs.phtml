if ($block->isAuthenticated()) {
    $_gridrecords = $block->getCollection(
        $postedData["txtId"],
        $postedData["cboModule"],
        $postedData["txtSubmittedFrom"],
        $postedData["txtSubmittedTo"]
    );

    // get collection which we set in block class
    ?>

    <?php if ($_gridrecords && count($_gridrecords)) { ?>
        <div class="table-wrapper orders-history">
            <table class="data table table-order-items history" id="my-orders-table">
                <caption class="table-caption"><?= $block->escapeHtml('Grid Record') ?></caption>
                <thead>
                    <tr>
                        <th scope="col" class="col id"><?= $block->escapeHtml(__('ID #')) ?></th>
                        <th scope="col" class="col id"><?= $block->escapeHtml(__('Module')) ?></th>
                        <th scope="col" class="col date"><?= $block->escapeHtml(__('Submitted On')) ?></th>
                        <th scope="col" class="col date">Processed On</th>
                        <th scope="col" class="col status"><?= $block->escapeHtml(__('Status')) ?></th>
                        <th scope="col" class="col job"><?= $block->escapeHtml(__('Job')) ?></th>
                        <th scope="col" class="col joblog"><?= $block->escapeHtml(__('Log')) ?></th>
                        <th scope="col" class="col jobstacktrace"><?= $block->escapeHtml(__('Stack Trace')) ?></th>
                        <th scope="col" class="col ">&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    // read collection as magento1.x and display in list
                    foreach ($_gridrecords as $_gridrecord) {
                        $status = $_gridrecord->getStatus();
                        $color = "";
                        switch ($_gridrecord->getStatus()) {
                            case -1:
                                $status = "error";
                                $color = "#FFAF9B";
                                break;
                            case 0:
                                $status = "submitted";
                                $color = "#FFFF99";
                                break;
                            case 1:
                                $status = "processing";
                                $color = "#A8FFA8";
                                break;
                            case 2:
                                $status = "completed";
                                $color = "#CAE4FF";
                                break;
                        }
                        ?>
                        <tr style="background-color:<?= $block->escapeHtml($color) ?>">
                            <td class="col id">
                                <?= $block->escapeHtml($_gridrecord->getId()) ?>
                            </td>
                            <td class="col">
                                <?= $block->escapeHtml(
                                    $_gridrecord->getModule() == "" ? "import" : $_gridrecord->getModule()
                                ) ?>
                            </td>
                            <td class="col date"><?= $block->escapeHtml($_gridrecord->getSubmittedon()) ?></td>
                            <td class="col date"><?= $block->escapeHtml($_gridrecord->getProcessedon()) ?></td>
                            <td class="col status"><?= $block->escapeHtml($status) ?></td>
                            <td class="col job">
                                <a target="_blank" 
                                href="<?=
                                      $block->escapeHtml(
                                          $block->getQueryString(
                                              'getjob',
                                              $_gridrecord->getId(),
                                              $postedData
                                          )
                                      )
                                        ?>">Job</a>
                            </td>
                            <td class="col joblog">
                                <a target="_blank" 
                                   href="<?=
                                          $block->escapeHtml(
                                              $block->getQueryString(
                                                  'joblog',
                                                  $_gridrecord->getId(),
                                                  $postedData
                                              )
                                          )
                                            ?>">Log</a>
                            </td>
                            <td class="col jobstacktrace">
                                <a target="_blank" 
                                    href="<?=
                                          $block->escapeHtml(
                                              $block->getQueryString(
                                                  'jobstacktrace',
                                                  $_gridrecord->getId(),
                                                  $postedData
                                              )
                                          )
                                            ?>">Stack Trace</a>
                            </td>
                            <td></td>
                        </tr>
                    <?php } ?>
                </tbody>
            </table>
        </div>

    <?php } else { ?>
        <div class="message info empty"><span>
            <?= $block->escapeHtml(__('grid records are not available.')); ?></span>
